# install.sh generates .env with random secrets. Never commit .env.
MULTICA_IMAGE_TAG=latest
POSTGRES_USER=multica
POSTGRES_DB=multica
POSTGRES_PASSWORD=GENERATE_ON_INSTALL
JWT_SECRET=GENERATE_ON_INSTALL
FRONTEND_PORT=3100
BACKEND_PORT=8180
FRONTEND_ORIGIN=http://localhost:3100
MULTICA_APP_URL=http://localhost:3100
DO_NOT_TRACK=1
RUNTIME_MEMORY_LIMIT=4g
RUNTIME_CPUS=2
RUNTIME_MAX_CONCURRENT_TASKS=1
QA_DOCKER_CPUS=2
QA_DOCKER_MEMORY_LIMIT=2g
RELAY_HTTP_PORT=8090
# Set exact versions for repeatable builds, or latest for updates on each rebuild.
CLAUDE_VERSION=latest
KIRO_VERSION=latest
CODEX_VERSION=latest
OPENCODE_VERSION=latest
